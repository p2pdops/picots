  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2pdops/picots.git"
  },
  "bugs": {
    "url": "https://github.com/p2pdops/picots/issues"
  },
  "homepage": "https://p2pdops.github.io/picots/",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
