{
  "name": "@picots/cli",
  "version": "0.0.26",
  "description": "Master CLI compiler and bundler for PicoTS desktop applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "picots": "./bin/picots.js"
  },
